{
  "name": "@cosmosapp/pay_sdk",
  "version": "2.0.0",
  "description": "A powerful, object-oriented JavaScript/TypeScript SDK for the Cosmos Pay Payments API — server SDK (Stellar SEP-7 payment intents, webhooks, products, customers, analytics) plus a browser web client that auto-detects Freighter, xBull, Rabet, LOBSTR & Albedo wallets and signs transactions for you.",
  "keywords": [
    "cosmos",
    "cosmos-pay",
    "stellar",
    "sep-7",
    "payments",
    "payment-intents",
    "webhooks",
    "sdk",
    "api",
    "client",
    "typescript",
    "wallet",
    "freighter",
    "xbull",
    "albedo",
    "rabet",
    "lobstr",
    "browser"
  ],
  "license": "Apache-2.0",
  "author": "Cosmos Pay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmosPay/CosmosJS_SDK.git"
  },
  "bugs": {
    "url": "https://github.com/CosmosPay/CosmosJS_SDK/issues"
  },
  "homepage": "https://github.com/CosmosPay/CosmosJS_SDK#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "require": {
        "types": "./dist/web/index.d.cts",
        "default": "./dist/web/index.cjs"
      }
    },
    "./swk": {
      "import": {
        "types": "./dist/swk/index.d.ts",
        "default": "./dist/swk/index.js"
      },
      "require": {
        "types": "./dist/swk/index.d.cts",
        "default": "./dist/swk/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/client.test.mjs test/rest.test.mjs test/payment-intents.test.mjs test/swaps.test.mjs test/webhooks.test.mjs test/structures.test.mjs test/web.test.mjs test/catalogs.test.mjs test/cosmos-wallet.test.mjs test/liquidity.test.mjs test/ramps.test.mjs test/kyc-pollar.test.mjs",
    "test:watch": "node --test --watch test/client.test.mjs test/rest.test.mjs test/payment-intents.test.mjs test/swaps.test.mjs test/webhooks.test.mjs test/structures.test.mjs test/web.test.mjs test/catalogs.test.mjs test/cosmos-wallet.test.mjs test/liquidity.test.mjs test/ramps.test.mjs test/kyc-pollar.test.mjs",
    "prepublishOnly": "npm run build",
    "changelog": "npx --yes git-cliff@2 -o CHANGELOG.md",
    "llms": "node scripts/build-llms.mjs",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=11"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
